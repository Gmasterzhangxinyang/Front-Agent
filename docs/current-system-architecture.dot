digraph FrontAgentArchitectureMap {
  graph [
    label="Front-Agent 当前系统架构地图 · 单图泳道版",
    labelloc=t,
    labeljust=l,
    fontsize=34,
    fontname="Arial",
    rankdir=TB,
    bgcolor="#F8FAFC",
    pad=0.45,
    nodesep=0.34,
    ranksep=0.72,
    splines=polyline,
    outputorder=edgesfirst,
    newrank=true
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Arial",
    fontsize=15,
    color="#CBD5E1",
    fillcolor="#FFFFFF",
    fontcolor="#0F172A",
    penwidth=1.5,
    margin="0.18,0.13"
  ];
  edge [
    color="#2563EB",
    fontname="Arial",
    fontsize=12,
    fontcolor="#334155",
    penwidth=2.2,
    arrowsize=0.85
  ];

  legend [
    shape=plain,
    label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="10" CELLPADDING="4">
        <TR>
          <TD ALIGN="LEFT"><FONT POINT-SIZE="15"><B>阅读方式：</B>先沿 A 泳道从 ① → ⑧ 阅读；再按相同编号查看 B / C 明细；最后看 D / E 的横切能力。</FONT></TD>
          <TD BGCOLOR="#DBEAFE"><FONT COLOR="#1D4ED8">━━ 实时主链</FONT></TD>
          <TD BGCOLOR="#F3E8FF"><FONT COLOR="#7E22CE">业务策略</FONT></TD>
          <TD BGCOLOR="#D1FAE5"><FONT COLOR="#047857">权限与副作用</FONT></TD>
          <TD BGCOLOR="#FFE4E6"><FONT COLOR="#BE123C">失败 / 风险</FONT></TD>
        </TR>
      </TABLE>
    >
  ];

  subgraph cluster_main {
    label="A · 实时请求主链（唯一主阅读路径，从左到右）";
    labeljust=l;
    fontsize=23;
    fontname="Arial";
    color="#93C5FD";
    fillcolor="#EFF6FF";
    style="rounded,filled";
    penwidth=2;
    margin=24;

    p1 [
      label="① 事件进入\n客户 → Front\nRule Webhook",
      fillcolor="#DBEAFE",
      color="#60A5FA",
      fontsize=17,
      width=2.15,
      height=1.05
    ];
    p2 [
      label="② 信任 + 落盘\n验签 / 校验 / 去重\nDurable Intake",
      fillcolor="#DBEAFE",
      color="#60A5FA",
      fontsize=17,
      width=2.3,
      height=1.05
    ];
    p3 [
      label="③ 构建上下文\n会话 / 附件 / State\nCase Memory",
      fillcolor="#EDE9FE",
      color="#A78BFA",
      fontsize=17,
      width=2.3,
      height=1.05
    ];
    p4 [
      label="④ 分类与决策\n16 类 + Flags\nPython RouteDecision",
      fillcolor="#EDE9FE",
      color="#A78BFA",
      fontsize=17,
      width=2.45,
      height=1.05
    ];
    p5 [
      label="⑤ 两层业务策略\n确定性路由\n或 LLM Skill",
      fillcolor="#F3E8FF",
      color="#C084FC",
      fontsize=17,
      width=2.25,
      height=1.05
    ];
    p6 [
      label="⑥ 安全执行\nSchema / 可信绑定\nAction 去重",
      fillcolor="#D1FAE5",
      color="#34D399",
      fontsize=17,
      width=2.3,
      height=1.05
    ];
    p7 [
      label="⑦ 外部副作用\nFront / Linear / Feishu\nDocs / GitHub",
      fillcolor="#D1FAE5",
      color="#34D399",
      fontsize=17,
      width=2.35,
      height=1.05
    ];
    p8 [
      label="⑧ 结果持久化\nState / Action / Queue\n保持开放或恢复",
      fillcolor="#CFFAFE",
      color="#22D3EE",
      fontsize=17,
      width=2.35,
      height=1.05
    ];

    { rank=same; p1; p2; p3; p4; p5; p6; p7; p8; }
    p1 -> p2 [label="签名事件"];
    p2 -> p3 [label="已认证"];
    p3 -> p4 [label="可信上下文"];
    p4 -> p5 [label="分类结果"];
    p5 -> p6 [label="动作候选"];
    p6 -> p7 [label="已授权"];
    p7 -> p8 [label="工具结果"];
  }

  subgraph cluster_decision {
    label="B · 接入、理解与业务策略明细（编号对应 A 泳道）";
    labeljust=l;
    fontsize=23;
    fontname="Arial";
    color="#C4B5FD";
    fillcolor="#FAF5FF";
    style="rounded,filled";
    penwidth=2;
    margin=24;

    access [
      shape=plain,
      label=<
        <TABLE BORDER="1" COLOR="#93C5FD" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#FFFFFF">
          <TR><TD BGCOLOR="#DBEAFE"><FONT POINT-SIZE="18"><B>①–② 接入与可靠性</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><B>入口</B> · main.py → webhooks/front_webhook.py<BR ALIGN="LEFT"/>
          POST /webhook/front；Front HMAC-SHA1 + Base64 验签<BR ALIGN="LEFT"/>
          校验 JSON / conversation_id；Front event_id 优先，否则 SHA-256(body)<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>
          <B>先落盘再处理</B> · services/webhook_inbox.py<BR ALIGN="LEFT"/>
          webhook_inbox Commit → 请求内立即处理<BR ALIGN="LEFT"/>
          每会话 asyncio.Lock；全局 Semaphore=2<BR ALIGN="LEFT"/>
          原子 Claim + UUID Token + 15 分钟 Lease<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>
          <B>入站过滤</B><BR ALIGN="LEFT"/>
          拒绝 Draft / Comment / Outbound / @dify.ai 内部来源<BR ALIGN="LEFT"/>
          仅处理有正文或附件的外部消息；只允许 Support inbox inb_f9fvf</TD></TR>
        </TABLE>
      >
    ];

    understanding [
      shape=plain,
      label=<
        <TABLE BORDER="1" COLOR="#C4B5FD" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#FFFFFF">
          <TR><TD BGCOLOR="#EDE9FE"><FONT POINT-SIZE="18"><B>③–④ 上下文、分类与路由</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><B>Conversation Context</B> · agent/orchestrator.py<BR ALIGN="LEFT"/>
          conversation_states 控制续接；加载完整消息历史并排除未发送 Draft<BR ALIGN="LEFT"/>
          最多 5 个附件；图片 Base64；PDF/Word 文本最多 50k 字<BR ALIGN="LEFT"/>
          下载只准 HTTPS + 精确 Host Allowlist；响应头与流式读取双重 10MB 限额<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>
          <B>Case Memory</B> · services/case_memory.py<BR ALIGN="LEFT"/>
          最近 300 候选 → Token Overlap 阈值 → 最多 4 条成功/警示信号<BR ALIGN="LEFT"/>
          邮箱与电话脱敏；仅作参考，不能覆盖路由、工具和安全规则<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>
          <B>Classification</B> · skills/classify.md + classification.py<BR ALIGN="LEFT"/>
          16 Categories + Sub-type + Summary + Flags + Evidence + Paid/Premium/Urgency<BR ALIGN="LEFT"/>
          解析失败或非白名单值 → unclear；Confidence 只观测，不参与阈值路由</TD></TR>
        </TABLE>
      >
    ];

    deterministic [
      shape=plain,
      label=<
        <TABLE BORDER="1" COLOR="#D8B4FE" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#FFFFFF">
          <TR><TD BGCOLOR="#F3E8FF"><FONT POINT-SIZE="18"><B>⑤A Python 确定性路由</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><B>agent/routing.py · handled_before_skill=true</B><BR ALIGN="LEFT"/>
          spam / 明确广告 → Archive → closed_spam<BR ALIGN="LEFT"/>
          unclear / 安全冲突 → Forward Bobby → manual_review<BR ALIGN="LEFT"/>
          legal / legal_threat → Forward Geyan → forwarded_keep_open<BR ALIGN="LEFT"/>
          security → Move Security Inbox → moved_inbox<BR ALIGN="LEFT"/>
          marketing / Creator → Move Marketing + Comment<BR ALIGN="LEFT"/>
          business / Enterprise / Procurement → Move Business + Comment<BR ALIGN="LEFT"/>
          partnership / Marketplace / Plugin → Forward marketing@dify.ai + Reopen<BR ALIGN="LEFT"/>
          任一工具失败 → failed_needs_review</TD></TR>
        </TABLE>
      >
    ];

    skill_flow [
      shape=plain,
      label=<
        <TABLE BORDER="1" COLOR="#D8B4FE" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#FFFFFF">
          <TR><TD BGCOLOR="#F3E8FF"><FONT POINT-SIZE="18"><B>⑤B 受约束的 LLM Skill Flow</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><B>agent/orchestrator.py + skills/*.md · 最多 10 轮</B><BR ALIGN="LEFT"/>
          education：Linear → Sybil Queue → Draft → State；续接不重复建 Ticket<BR ALIGN="LEFT"/>
          account：登录 / 删除 / 转移 / 异常 / 被盗 / 合并；默认 Draft<BR ALIGN="LEFT"/>
          technical：Docs/GitHub Grounding；付费且严重才建 Linear；默认 Draft<BR ALIGN="LEFT"/>
          billing：退款 / 重复扣款 / 降级 / 发票；Credit Note 仅批准的两轮流程<BR ALIGN="LEFT"/>
          purchase：Enterprise / Premium / Pro-Team / Promo / Reseller<BR ALIGN="LEFT"/>
          investment → Claudia；roadmap / data_export / recruiting → Draft<BR ALIGN="LEFT"/>
          只能选择 TOOL_SCHEMAS 中的工具；不能任意调用 API</TD></TR>
        </TABLE>
      >
    ];

    { rank=same; access; understanding; deterministic; skill_flow; }
    access -> understanding -> deterministic -> skill_flow [style=invis, weight=100];
  }

  subgraph cluster_execution {
    label="C · 权限、安全执行与失败恢复（这里才是真正的副作用边界）";
    labeljust=l;
    fontsize=23;
    fontname="Arial";
    color="#6EE7B7";
    fillcolor="#ECFDF5";
    style="rounded,filled";
    penwidth=2;
    margin=24;

    guard [
      shape=plain,
      label=<
        <TABLE BORDER="1" COLOR="#6EE7B7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#FFFFFF">
          <TR><TD BGCOLOR="#D1FAE5"><FONT POINT-SIZE="18"><B>⑥ Tool Registry 权限墙</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><B>agent/tool_registry.py · 19 个模型可见白名单工具</B><BR ALIGN="LEFT"/>
          拒绝未知工具、缺参、多余参数、错误类型与非法 Enum<BR ALIGN="LEFT"/>
          conversation_id / Original Sender / Original Message 强制绑定可信上下文<BR ALIGN="LEFT"/>
          Draft 收件人执行前再次固定为原始外部 Sender<BR ALIGN="LEFT"/>
          Education 已有 Ticket 时禁止再次创建 Linear，并保留可信 linear_url<BR ALIGN="LEFT"/>
          无通用 Forward；Direct Reply 永久 Block；Close 不暴露给 LLM<BR ALIGN="LEFT"/>
          只有确定性 Spam 路径拥有 Archive/Close 内部授权</TD></TR>
        </TABLE>
      >
    ];

    idempotency [
      shape=plain,
      label=<
        <TABLE BORDER="1" COLOR="#6EE7B7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#FFFFFF">
          <TR><TD BGCOLOR="#D1FAE5"><FONT POINT-SIZE="18"><B>⑥ Action Idempotency</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT">进程内 Action Lock + conversation_actions 持久记录<BR ALIGN="LEFT"/>
          Draft / Comment Key = Body Hash<BR ALIGN="LEFT"/>
          Handoff Key = Summary Hash<BR ALIGN="LEFT"/>
          Sybil Key = Notification Type + Linear URL<BR ALIGN="LEFT"/>
          Linear Key = Trusted Sender + Original Body<BR ALIGN="LEFT"/>
          命中时复用历史成功结果；只记录成功，失败仍可重试</TD></TR>
        </TABLE>
      >
    ];

    tools [
      shape=plain,
      label=<
        <TABLE BORDER="1" COLOR="#6EE7B7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#FFFFFF">
          <TR><TD BGCOLOR="#D1FAE5"><FONT POINT-SIZE="18"><B>⑦ tools/*.py 与外部系统</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><B>Front</B>：读取会话、Draft、Comment、Tag、Move、Reopen、Archive、重建线程 Forward<BR ALIGN="LEFT"/>
          <B>Handoff</B>：内部收件人必须是 @dify.ai<BR ALIGN="LEFT"/>
          <B>Linear GraphQL</B>：只在 CUS Project 建 Issue<BR ALIGN="LEFT"/>
          <B>Dify Docs / GitHub Search</B>：只读 Grounding<BR ALIGN="LEFT"/>
          <B>Sybil + Feishu</B>：Pending → Sending（30m Lease）→ Sent<BR ALIGN="LEFT"/>
          <B>State</B>：保留原始 Sender、30 天历史与 Action 查询<BR ALIGN="LEFT"/>
          LLM：OpenAI-compatible，默认 gpt-5.5；可配置 MiniMax Base URL</TD></TR>
        </TABLE>
      >
    ];

    recovery [
      shape=plain,
      label=<
        <TABLE BORDER="1" COLOR="#FB7185" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#FFFFFF">
          <TR><TD BGCOLOR="#FFE4E6"><FONT POINT-SIZE="18"><B>⑧ 结果、异常与恢复回路</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><B>成功</B>：保存 State / Action / Queue；写 webhook_events；Inbox=processed 并清 Payload<BR ALIGN="LEFT"/>
          非 Spam 默认保持会话开放；Skill 未写 State → failed_needs_review<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>
          <B>异常</B>：去重 Forward Bobby + Reopen + failed_needs_review + HTTP 503<BR ALIGN="LEFT"/>
          失败时不写 webhook_events；webhook_inbox 保留 Payload<BR ALIGN="LEFT"/>
          退避 1 / 5 / 15 / 60 / 180 分钟；第 6 次转 Dead Letter<BR ALIGN="LEFT"/>
          Scheduler 每分钟 Claim 到期任务；过期 Lease 可重新处理</TD></TR>
        </TABLE>
      >
    ];

    { rank=same; guard; idempotency; tools; recovery; }
    guard -> idempotency -> tools -> recovery [style=invis, weight=100];
  }

  subgraph cluster_dataops {
    label="D · 持久化、后台任务与运营观测（横切所有实时阶段）";
    labeljust=l;
    fontsize=23;
    fontname="Arial";
    color="#FACC15";
    fillcolor="#FEFCE8";
    style="rounded,filled";
    penwidth=2;
    margin=24;

    data [
      shape=plain,
      label=<
        <TABLE BORDER="1" COLOR="#FACC15" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#FFFFFF">
          <TR><TD BGCOLOR="#FEF9C3"><FONT POINT-SIZE="18"><B>SQLite · database.py / models.py</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT">conversation_states · 类别 / Step / Payload / Waiting / 原始 Sender<BR ALIGN="LEFT"/>
          webhook_inbox · Durable Payload / Status / Attempts / Lease / Error<BR ALIGN="LEFT"/>
          webhook_events · 成功 Event 去重<BR ALIGN="LEFT"/>
          conversation_actions · 成功副作用去重<BR ALIGN="LEFT"/>
          sybil_notifications · Pending / Sending / Sent / Dismissed<BR ALIGN="LEFT"/>
          draft_adoptions · Exact / Modified / Manual / Waiting / No-followup<BR ALIGN="LEFT"/>
          ops_reports · 日 / 周 / 月 JSON 报告</TD></TR>
        </TABLE>
      >
    ];

    jobs [
      shape=plain,
      label=<
        <TABLE BORDER="1" COLOR="#FACC15" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#FFFFFF">
          <TR><TD BGCOLOR="#FEF9C3"><FONT POINT-SIZE="18"><B>APScheduler · Asia/Shanghai</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><B>每 1 分钟</B>：重试 Due / 过期 Lease Webhook，单批最多 20<BR ALIGN="LEFT"/>
          <B>每 15 分钟</B>：回填缺失 Ops Sender / Summary，最多 20，60s 超时<BR ALIGN="LEFT"/>
          <B>每 3 小时</B>：刷新近 30 天 Draft Adoption + 日/周/月报告<BR ALIGN="LEFT"/>
          <B>每天 10:00</B>：最多 100 条 Sybil 合并为 Feishu Digest<BR ALIGN="LEFT"/>
          <B>每 6 小时</B>：等待超过 10 天的会话 Archive + done<BR ALIGN="LEFT"/>
          Shutdown：等待在途任务最多 60 秒</TD></TR>
        </TABLE>
      >
    ];

    ops [
      shape=plain,
      label=<
        <TABLE BORDER="1" COLOR="#FACC15" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#FFFFFF">
          <TR><TD BGCOLOR="#FEF9C3"><FONT POINT-SIZE="18"><B>Ops Dashboard · routes/ops.py</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT">常量时间登录校验；同客户端 5 分钟最多 5 次失败<BR ALIGN="LEFT"/>
          进程内随机 Session；HttpOnly；SameSite=Strict；默认 12h<BR ALIGN="LEFT"/>
          Summary / Report / Conversations / Actions / Sybil 读取<BR ALIGN="LEFT"/>
          写入还要求 X-Ops-Request: 1<BR ALIGN="LEFT"/>
          Metadata 只补空值，并保留业务 updated_at<BR ALIGN="LEFT"/>
          Pending Sybil 可 CAS Soft-dismiss，并写审计 Action</TD></TR>
        </TABLE>
      >
    ];

    { rank=same; data; jobs; ops; }
    data -> jobs -> ops [style=invis, weight=100];
  }

  subgraph cluster_boundaries {
    label="E · 系统保证、明确限制与仓库覆盖";
    labeljust=l;
    fontsize=23;
    fontname="Arial";
    color="#94A3B8";
    fillcolor="#F1F5F9";
    style="rounded,filled";
    penwidth=2;
    margin=24;

    guarantees [
      shape=plain,
      label=<
        <TABLE BORDER="1" COLOR="#34D399" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#FFFFFF">
          <TR><TD BGCOLOR="#D1FAE5"><FONT POINT-SIZE="18"><B>当前保证</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT">Durable Intake + At-least-once Processing<BR ALIGN="LEFT"/>
          进程内会话锁 / Action Lock + 成功 Action 去重<BR ALIGN="LEFT"/>
          Customer Draft-first；非 Spam 默认保持开放<BR ALIGN="LEFT"/>
          LLM 只负责理解、草稿和白名单动作候选<BR ALIGN="LEFT"/>
          Python 掌握信任、权限、收件人、关闭与恢复</TD></TR>
        </TABLE>
      >
    ];

    limitations [
      shape=plain,
      label=<
        <TABLE BORDER="1" COLOR="#FB7185" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#FFFFFF">
          <TR><TD BGCOLOR="#FFE4E6"><FONT POINT-SIZE="18"><B>明确限制</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT">不是 Exactly-once：外部成功、本地 Commit 前崩溃仍可能重复<BR ALIGN="LEFT"/>
          进程内 Lock 与 Ops Session 不跨多实例<BR ALIGN="LEFT"/>
          默认 SQLite 为本地状态<BR ALIGN="LEFT"/>
          无 Provider Idempotency Key / 外部副作用 Reconciliation</TD></TR>
        </TABLE>
      >
    ];

    repository [
      shape=plain,
      label=<
        <TABLE BORDER="1" COLOR="#94A3B8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#FFFFFF">
          <TR><TD BGCOLOR="#E2E8F0"><FONT POINT-SIZE="18"><B>仓库与运行覆盖</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT">10 个 tests/*.py：Routing / Skills / Recovery / Ops / Dedupe<BR ALIGN="LEFT"/>
          railway.toml → start.sh → Uvicorn；GET /health<BR ALIGN="LEFT"/>
          README / CLAUDE / SOP / Runtime Boundaries<BR ALIGN="LEFT"/>
          Specs / Plans / Test Cases / Architecture Map</TD></TR>
        </TABLE>
      >
    ];

    { rank=same; guarantees; limitations; repository; }
    guarantees -> limitations -> repository [style=invis, weight=100];
  }

  legend -> p1 [style=invis, weight=100];
  p4 -> understanding [style=dashed, color="#A78BFA", penwidth=1.4, arrowsize=0.6];
  p5 -> deterministic [style=dashed, color="#A78BFA", penwidth=1.4, arrowsize=0.6];
  p5 -> skill_flow [style=dashed, color="#A78BFA", penwidth=1.4, arrowsize=0.6];
  understanding -> guard [style=invis, weight=30];
  skill_flow -> recovery [style=invis, weight=30];
  guard -> data [style=dashed, color="#94A3B8", penwidth=1.2, arrowsize=0.6, label="读写"];
  recovery -> jobs [style=dashed, color="#E11D48", penwidth=1.4, arrowsize=0.6, label="重试 / 报告"];
  data -> guarantees [style=invis, weight=30];
  ops -> repository [style=invis, weight=30];
}
