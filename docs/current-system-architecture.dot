digraph FrontAgentClearArchitecture {
  graph [
    label="Front-Agent 当前系统架构 · 清晰分层版",
    labelloc=t,
    fontsize=30,
    fontname="Arial",
    rankdir=TB,
    bgcolor="#F8FAFC",
    pad=0.35,
    nodesep=0.55,
    ranksep=0.72,
    splines=polyline,
    compound=true,
    newrank=true,
    ordering=out
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Arial",
    fontsize=13,
    color="#94A3B8",
    fillcolor="#FFFFFF",
    fontcolor="#0F172A",
    margin="0.18,0.12",
    penwidth=1.4
  ];
  edge [
    color="#475569",
    fontname="Arial",
    fontsize=10,
    fontcolor="#334155",
    arrowsize=0.8,
    penwidth=1.4
  ];

  subgraph cluster_external {
    label="① 外部入口与依赖";
    color="#A5B4FC";
    fillcolor="#EEF2FF";
    style="rounded,filled";

    customer [label="客户 / 外部发件人", fillcolor="#E0E7FF"];
    front [label="Front Cloud\nRule Webhook + REST API\nSupport / Security / Marketing / Business Inbox", fillcolor="#E0E7FF"];
    providers [
      label="外部服务\nOpenAI-compatible LLM（默认 gpt-5.5，可切 MiniMax）\nLinear GraphQL · Dify Docs · GitHub Search · Feishu",
      fillcolor="#E0E7FF"
    ];

    customer -> front [label="邮件 / 后续回复"];
    { rank=same; customer; front; providers; }
  }

  subgraph cluster_ingress {
    label="② Webhook 安全接入与持久恢复";
    color="#60A5FA";
    fillcolor="#EFF6FF";
    style="rounded,filled";

    webhook [
      label="HTTP 边界 · main.py / webhooks/front_webhook.py\nPOST /webhook/front\nHMAC-SHA1 + Base64 验签 · JSON / conversation_id 校验\nevent_id 优先使用 Front ID，否则 SHA-256(body)",
      fillcolor="#DBEAFE"
    ];
    intake [
      label="Durable Intake · services/webhook_inbox.py\n认证事件先写 webhook_inbox 并 Commit，再立即处理\n每会话 asyncio.Lock · 全局 Semaphore=2\n原子 Claim · UUID Token · 15 分钟 Lease",
      fillcolor="#DBEAFE"
    ];
    inbound_guard [
      label="可信消息过滤\n拒绝 Draft / Comment / Outbound / @dify.ai 内部来源\n只接受有正文或附件的外部入站消息\nGET Front Inboxes：仅 Support inb_f9fvf",
      fillcolor="#DBEAFE"
    ];
    recovery [
      label="失败与恢复\n异常：去重转 Bobby + Reopen + failed_needs_review + HTTP 503\n不写 webhook_events\n退避 1 / 5 / 15 / 60 / 180 分钟；第 6 次 Dead Letter\n成功：写 webhook_events；Inbox=processed 并清空 Payload",
      fillcolor="#FFE4E6",
      color="#FB7185"
    ];

    webhook -> intake -> inbound_guard;
    recovery -> intake [style=dashed, label="内部重试", color="#E11D48", constraint=false];
  }

  front -> webhook [label="签名 Webhook"];

  subgraph cluster_understanding {
    label="③ 上下文构建、分类与路由决策";
    color="#C4B5FD";
    fillcolor="#F5F3FF";
    style="rounded,filled";

    context [
      label="Conversation Context · agent/orchestrator.py\n读取 conversation_states；控制多轮续接\n完整 Front 消息历史，剔除未发送 Draft\n附件最多 5 个：图片 Base64；PDF/Word 文本最多 50k 字\n附件下载：HTTPS + 精确 Host Allowlist + 10MB 双限额",
      fillcolor="#EDE9FE"
    ];
    memory [
      label="辅助上下文\nCase Memory：最近 300 候选，Overlap 阈值后最多取 4 条\n成功 / 警示信号分组；邮箱和电话脱敏；不能覆盖安全规则\n需要时由 LLM 决定是否补充同 Sender 30 天历史",
      fillcolor="#EDE9FE"
    ];
    classify [
      label="LLM Classification · skills/classify.md + classification.py\n16 Categories + Sub-type\nSummary / Flags / Evidence / Paid / Premium / Urgency / Confidence\n解析纯 JSON / Code Fence / Balanced Object\n失败或非白名单值 → unclear；Confidence 仅用于观测",
      fillcolor="#EDE9FE"
    ];
    route [
      label="RouteDecision\nPython 决定是否在 Skill 前处理",
      shape=diamond,
      fillcolor="#FFEDD5",
      color="#F97316",
      width=2.6,
      height=1.0
    ];

    context -> memory -> classify -> route;
  }

  inbound_guard -> context;
  classify -> providers [dir=both, style=dashed, label="LLM", constraint=false];

  subgraph cluster_policy {
    label="④ 两层业务策略（并列而非混在一个 Agent 中）";
    color="#A78BFA";
    fillcolor="#FAF5FF";
    style="rounded,filled";

    deterministic [
      label="A. Python 确定性路由 · agent/routing.py\n\n• spam / 明确广告 → Archive → closed_spam\n• unclear / 不安全冲突 → Front Forward Bobby → manual_review\n• legal / legal_threat → Forward Geyan → forwarded_keep_open\n• security → Move Security Inbox → moved_inbox\n• marketing / Creator Collaboration → Move Marketing + Comment\n• business / Enterprise / Procurement → Move Business + Comment\n• partnership / Marketplace / Plugin → Forward marketing@dify.ai + Reopen\n\n工具失败统一落入 failed_needs_review",
      fillcolor="#F3E8FF",
      color="#9333EA",
      width=5.7
    ];

    skills [
      label="B. LLM Skill Flow · skills/*.md\n\n• education：申请 / 拒绝 / 无折扣 / 毕业邮箱 / 取消\n  审核顺序 Linear → Sybil Queue → Draft → State；续接禁止重复 Linear\n• account：登录 / 删除 / 转移 / 异常 / 被盗 / 合并；默认 Draft\n• technical：Docs/GitHub Grounding；付费且严重才建 Linear；默认 Draft\n• billing：退款 / 重复扣款 / 降级 / 发票；Credit Note 仅批准的两轮流程\n• purchase：Enterprise / Premium / Pro-Team / Promo / Reseller\n• investment → Claudia；roadmap / data_export / recruiting → Draft\n\nAgent Loop 最多 10 轮，只能调用 TOOL_SCHEMAS",
      fillcolor="#F3E8FF",
      color="#9333EA",
      width=6.4
    ];

    { rank=same; deterministic; skills; }
  }

  route -> deterministic [label="handled_before_skill=true"];
  route -> skills [label="false / 获准多轮续接"];
  skills -> providers [dir=both, style=dashed, label="Function Calling", constraint=false];

  subgraph cluster_execution {
    label="⑤ 权限与副作用执行（真正的安全边界）";
    color="#6EE7B7";
    fillcolor="#ECFDF5";
    style="rounded,filled";

    tool_guard [
      label="Tool Registry · agent/tool_registry.py\n19 个模型可见白名单工具\n拒绝未知工具、缺参、多余参数、错误类型与 Enum\n强制绑定可信 conversation_id / 原始 Sender / Original Message\nEducation 已有 Ticket 时阻止新 Linear；保留可信 linear_url\n无任意 Forward；Direct Reply 永久 Block；Close 仅确定性 Spam 内部授权",
      fillcolor="#D1FAE5"
    ];
    dedupe [
      label="Action Idempotency\n进程内 Action Lock + conversation_actions\nDraft/Comment=Body Hash · Handoff=Summary Hash\nSybil=Type+Linear URL · Linear=Trusted Sender+Original Body\n命中复用成功结果；只记录成功，失败允许重试",
      fillcolor="#D1FAE5"
    ];
    concrete_tools [
      label="具体工具 · tools/*.py\nFront：读会话、Draft、Comment、Tag、Move、Reopen、Archive、重建线程 Forward\nHandoff：内部收件人必须 @dify.ai\nLinear：CUS Issue；Docs/GitHub：只读搜索\nSybil：Pending → Sending(30m Lease) → Sent；Feishu 群机器人发送\nState：保留原始外部 Sender、30 天历史、Action 查询",
      fillcolor="#D1FAE5"
    ];
    outcome [
      label="处理结果\n成功：保存 State / Action / Queue 并保持非 Spam 会话开放\nSkill 没有写 State：自动 failed_needs_review\n未处理异常：进入 Webhook Failure / Recovery",
      fillcolor="#DCFCE7",
      color="#22C55E"
    ];

    tool_guard -> dedupe -> concrete_tools -> outcome;
  }

  deterministic -> tool_guard;
  skills -> tool_guard;
  concrete_tools -> providers [dir=both, style=dashed, label="Front / Linear / Docs / GitHub / Feishu", constraint=false];
  outcome -> recovery [style=dashed, label="异常", color="#E11D48", constraint=false];

  subgraph cluster_dataops {
    label="⑥ 数据、后台任务与运营观测";
    color="#FACC15";
    fillcolor="#FEFCE8";
    style="rounded,filled";

    data [
      label="SQLite · database.py / models.py\n\nconversation_states：类别 / Step / Payload / Waiting / 原始 Sender\nwebhook_inbox：Durable Payload / Status / Attempts / Lease / Error\nwebhook_events：成功 Event 去重\nconversation_actions：成功副作用去重\nsybil_notifications：Pending / Sending / Sent / Dismissed\ndraft_adoptions：草稿采纳分类与时间\nops_reports：日 / 周 / 月 JSON 报告",
      shape=cylinder,
      fillcolor="#FEF9C3",
      width=5.7
    ];
    scheduler [
      label="APScheduler · Asia/Shanghai\n\n每 1 分钟：重试 Due / 过期 Lease Webhook（最多 20）\n每 15 分钟：回填缺失 Ops Sender/Summary（最多 20，60s 超时）\n每 3 小时：刷新近 30 天 Draft Adoption + 日/周/月报告\n每天 10:00：最多 100 条 Sybil 合并为 Feishu Digest\n每 6 小时：等待超过 10 天的会话 Archive + done\nShutdown：等待在途任务最多 60 秒",
      fillcolor="#FEF9C3",
      width=5.7
    ];
    ops [
      label="Ops Dashboard · routes/ops.py\n\n登录：常量时间校验；同客户端 5 分钟 5 次失败限流\nSession：进程内随机 Token，HttpOnly，SameSite=Strict，默认 12h\n读取：Summary / Report / Conversations / Actions / Sybil\n写入还需 X-Ops-Request: 1\nDraft Adoption：Exact / Modified / Manual / Waiting / No-followup\nMetadata：仅填空值且保留业务 updated_at\nPending Sybil 可 CAS Soft-dismiss，并写审计 Action",
      fillcolor="#FEF9C3",
      width=5.9
    ];

    { rank=same; data; scheduler; ops; }
    scheduler -> data [style=dashed, label="维护 / 报告"];
    ops -> data [dir=both, style=dashed, label="观测 / 审计"];
  }

  outcome -> data [label="State / Action / Queue"];

  subgraph cluster_boundaries {
    label="⑦ 保证边界与仓库覆盖";
    color="#FDA4AF";
    fillcolor="#FFF1F2";
    style="rounded,filled";

    guarantees [
      label="当前保证\nDurable Intake + At-least-once Processing\n进程内并发锁 + 成功 Action 去重\nCustomer Draft-first；非 Spam 默认保持开放",
      fillcolor="#DCFCE7",
      color="#22C55E",
      width=5.2
    ];
    limitations [
      label="明确限制\n不是 Exactly-once：外部成功、本地 Commit 前崩溃仍可能重复\n进程内 Lock / Ops Session 不跨多实例\n默认 SQLite 本地状态；无 Provider Idempotency / Reconciliation",
      fillcolor="#FFE4E6",
      color="#F43F5E",
      width=5.8
    ];
    repository [
      label="仓库支持层\n10 个 tests/*.py 离线验证 Routing / Skills / Recovery / Ops / Dedupe\nrailway.toml → start.sh → Uvicorn；GET /health\nREADME / CLAUDE / SOP / Runtime Boundaries / Specs / Plans / Test Cases",
      fillcolor="#F1F5F9",
      width=5.8
    ];

    { rank=same; guarantees; limitations; repository; }
  }

  data -> guarantees [style=dashed];
}
